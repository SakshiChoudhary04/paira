# Root gitignore for repository

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build output
dist/
build/
out/
.next/
.nuxt/
.vercel/

# Cache
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Package managers
.pnp
.pnp.js

# Testing
jest-html-reporters-*
playwright-report/
test-results/

# Misc
*.tgz

# Local netlify/vercel configs
.netlify/
.vercel/
